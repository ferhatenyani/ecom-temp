{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(**)",
      "Bash(docker compose ps*)",
      "Bash(docker compose config*)",
      "Bash(docker compose up*)",
      "Bash(docker compose start*)",
      "Bash(docker compose stop*)",
      "Bash(docker compose restart*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose down)",
      "Bash(docker compose exec*)",
      "Bash(docker compose run --rm wpcli wp *)",
      "Bash(docker ps*)",
      "Bash(docker version*)",
      "Bash(docker compose version*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git stash*)",
      "Bash(git remote*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(composer *)",
      "Bash(php -l *)",
      "Bash(vendor/bin/phpunit*)",
      "Bash(./vendor/bin/phpunit*)",
      "Bash(./scripts/test.sh*)",
      "Bash(./scripts/health.sh*)",
      "Bash(./scripts/seed.sh*)",
      "Bash(./scripts/setup.sh*)",
      "Bash(curl http://localhost:*)"
    ],
    "ask": [
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker compose rm*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git push*)",
      "Bash(docker compose run --rm wpcli wp db drop*)",
      "Bash(docker compose run --rm wpcli wp db reset*)",
      "Bash(docker compose run --rm wpcli wp db import*)",
      "Bash(docker compose run --rm wpcli wp db query*)",
      "Bash(docker compose run --rm wpcli wp site empty*)",
      "Bash(docker compose run --rm wpcli wp post delete*)",
      "Bash(docker compose run --rm wpcli wp user delete*)",
      "Bash(./scripts/reset.sh*)",
      "Bash(rm *)",
      "Edit(.env)",
      "Edit(.gitignore)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf /*)",
      "Read(.env)",
      "Read(./backups/**)"
    ]
  }
}
