# Copy to .env and fill in. Never commit .env.
# Every environment (local / staging / production) uses its own values.

# Database
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Host port WordPress is published on
WP_PORT=8090

# Shipping providers
#
# Yalidine sends both of these as headers (X-API-ID, X-API-TOKEN) on every
# request; they are issued in the merchant dashboard, per account. The webhook
# secret is the `security_token` Yalidine puts in the *body* of a webhook — it
# is a shared secret to compare, not a signature to verify.
#
# Everything else about a Yalidine account — the origin wilaya, insurance,
# default parcel size — is a per-client setting rather than an environment
# variable: wp option update ac_yalidine_settings --format=json '{"origin_wilaya_id":16}'
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
YALIDINE_WEBHOOK_SECRET=

ZR_EXPRESS_TENANT_ID=
ZR_EXPRESS_API_KEY=
ZR_EXPRESS_WEBHOOK_SECRET=

# Payments
# One key, not two: Chargily signs its webhooks with the API secret key
# itself. Test keys start with test_sk_ and select the test environment.
CHARGILY_SECRET_KEY=

# Marketing pixels — roadmap §62b
#
# The pixel id is public: it ships inside the storefront's JavaScript, and
# GET /marketing/config serves it. The Conversions API token is a credential —
# it authorises writing conversions into your ad account, it is long-lived, and
# Meta does not rotate it for you.
#
# Everything else about the dataset is a per-client setting rather than an
# environment variable, including the Graph API version this shop is pinned to:
#   wp option update ac_meta_settings --format=json '{"test_event_code":"TEST12345"}'
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Email
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Feature flags — all default to off when unset
ENABLE_COD=
ENABLE_CHARGILY=
ENABLE_YALIDINE=
ENABLE_ZR_EXPRESS=
ENABLE_MARKETING_PIXELS=
ENABLE_BLOG=
ENABLE_REVIEWS=
ENABLE_SMS=
ENABLE_WHATSAPP=

# Log floor: debug | info | warning | error (defaults to info, or debug when WP_DEBUG is on)
AC_LOG_LEVEL=

# Rate limiting (per minute, per identity and per IP). Unset uses the defaults
# shown. AC_RATE_LIMIT_AUTH_FAILURES is per IP over a 15-minute window and is
# the brute-force guard on Application Passwords.
AC_RATE_LIMIT_READS=600
AC_RATE_LIMIT_WRITES=120
AC_RATE_LIMIT_AUTH_FAILURES=10

# POST /media only, on top of the write limit above. An upload moves a file and
# re-encodes an image, so it costs far more than the database write that number
# was sized for.
AC_RATE_LIMIT_UPLOADS=30

# The media upload cap, in bytes. Default 8388608 (8 MiB). PHP's own
# upload_max_filesize still wins — docker/php-uploads.ini raises it to 16M for
# this stack, and the plugin uses whichever of the two is lower.
AC_MEDIA_MAX_BYTES=8388608

# How long an analytics response may be reused, in seconds (default 60). A
# dashboard polls seven endpoints on one screen, and a minute of staleness costs
# nothing while a hundred repeated aggregations cost the database real work.
# Every response carries generated_at, so the age is always visible. 0 turns it
# off. This is deliberately a cache and not a pre-computed rollup — see the
# plugin README, §63.
AC_ANALYTICS_CACHE_TTL=60

# Addresses exempt from the authentication lockout — put the Next.js server
# here, or an attacker guessing its credential locks it out too. Exact IPs
# only, comma-separated; CIDR ranges and hostnames are dropped.
AC_RATE_LIMIT_TRUSTED_IPS=

# Emergency kill switch for all rate limiting. Leave empty.
AC_RATE_LIMIT_DISABLED=

# Environment type. WordPress refuses Application Passwords unless the request
# is HTTPS or this is "local" — development is plain HTTP, so it must be local.
# Staging and production run TLS and set their real value.
WP_ENVIRONMENT_TYPE=local

# CORS allowlist for /wp-json/algerian-commerce/v1 — comma-separated exact origins.
# Unset falls back to the development origins http://localhost:3000,http://localhost:3001.
# Set this explicitly in staging and production. Never "*".
# e.g. AC_CORS_ORIGINS=https://store.example.dz,https://admin.example.dz
AC_CORS_ORIGINS=

# --- Notifications (roadmap step 34, PLAN §29/§30) -------------------------
# Where operational alerts go — low stock, new orders. Falls back to WordPress's
# own admin_email, which on a headless install is often a placeholder nobody
# reads, so setting this is worth doing.
AC_ADMIN_EMAIL=

# The From: address on transactional mail. Falls back to admin_email.
# Both are passed through compose.yaml; a variable this file documents and
# compose.yaml does not pass reaches the plugin as an empty string (§61 found
# the whole AC_RATE_LIMIT_* group in exactly that state).
AC_MAIL_FROM=
