{
    "name": "algerian-commerce/core",
    "description": "Headless commerce application layer for WordPress/WooCommerce.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AlgerianCommerce\\": "src/",
            "AlgerianCommerce\\Integrations\\": "integrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlgerianCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
